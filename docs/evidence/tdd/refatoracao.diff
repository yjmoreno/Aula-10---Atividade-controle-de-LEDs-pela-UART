+/* CRC-8 com polinomio x^8 + x^2 + x + 1 (0x07), valor inicial 0x00 */
 uint8_t check_crc8(const uint8_t *dados, size_t n)
 {
     uint8_t crc = 0x00;
     for (size_t i = 0; i < n; i++) {
         crc ^= dados[i];
-        for (int b = 0; b < 8; b++) {
-            if (crc & 0x80) crc = (uint8_t)((crc << 1) ^ 0x07);
-            else crc = (uint8_t)(crc << 1);
-        }
+        for (int b = 0; b < 8; b++)
+            crc = (crc & 0x80) ? (uint8_t)((crc << 1) ^ 0x07) : (uint8_t)(crc << 1);
     }
     return crc;
 }
 
+static bool acao_valida(uint8_t a)
+{
+    return a >= ACAO_LIGAR && a <= ACAO_PISCA_2S;
+}
+
 Receptor::Receptor(uint8_t meu_id, uint32_t timeout_ms, bool usa_crc8)
     : id(meu_id), timeout(timeout_ms), crc8(usa_crc8), n(0), t_ultimo_byte(0), ultimo{} {}
 
+bool Receptor::passou_do_prazo(uint32_t agora_ms) const
+{
+    return n > 0 && agora_ms - t_ultimo_byte > timeout;
+}
+
 Resultado Receptor::recebe(uint8_t byte, uint32_t agora_ms)
 {
-    if (n > 0 && agora_ms - t_ultimo_byte > timeout) {
-        n = 0;
-    }
+    if (passou_do_prazo(agora_ms)) n = 0;     /* pacote velho, pela metade */
     t_ultimo_byte = agora_ms;
 
-    if (n == 0 && byte != id) {
-        return ERRO_ID;
-    }
-    buf[n] = byte;
-    n = n + 1;
-    if (n < PACOTE_TAM) {
-        return INCOMPLETO;
-    }
+    /* Todo pacote comeca pelo nosso ID. Qualquer outro byte nessa posicao
+     * e descartado na hora, e assim o receptor se ressincroniza sozinho. */
+    if (n == 0 && byte != id) return ERRO_ID;
 
-    n = 0;
-    uint8_t esperado;
-    if (crc8) {
-        esperado = check_crc8(buf, 5);
-    } else {
